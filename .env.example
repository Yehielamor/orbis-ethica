# Security
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here
KEY_PASSWORD=your_secure_password

# Network
PORT=8001
HOST=127.0.0.1
SEED_NODES=77.42.30.95:8000
P2P_PORT=8001
NODE_ID=my_node_v1

# Frontend Mode
FRONTEND_MODE=full  # Options: "full" (all features) or "public" (read-only, no miner)

# Mining
ENABLE_MINING=true

# LLM Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Oracle
ORACLE_SCAN_INTERVAL=300
